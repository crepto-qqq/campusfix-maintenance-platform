# Copy this file to backend/.env.local and replace the example values.
# backend/.env.local is ignored by Git. Never commit or screenshot its values.
CAMPUSFIX_ADMIN_PASSWORD=replace-with-a-strong-local-password
CAMPUSFIX_BREVO_API_KEY=xkeysib-replace_with_the_shared_brevo_api_key
CAMPUSFIX_EMAIL_FROM_NAME=CampusFix
CAMPUSFIX_EMAIL_FROM_ADDRESS=replace-with-the-verified-sender@example.com
CAMPUSFIX_GOOGLE_MAPS_API_KEY=replace-with-a-browser-restricted-google-maps-key

# Email verification is enabled by default. This switch is intended only for
# isolated automated tests; do not disable it in a normal application run.
CAMPUSFIX_EMAIL_VERIFICATION_REQUIRED=true
