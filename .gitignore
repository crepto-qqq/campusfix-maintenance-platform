hs_err_pid*
replay_pid*

# IDE and local development files
.idea/
.vscode/
frontend/node_modules/

# Environment variables and local secret configuration
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/application-local.properties
**/application-secrets.properties
**/application-*.local.properties
secrets/
credentials/
**/secrets/
**/credentials/

# API, OAuth and service-account credentials
client_secret*.json
service-account*.json
*credentials*.json

# Private keys, certificates and Java keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local account notes
docs/local-admin-account.txt

