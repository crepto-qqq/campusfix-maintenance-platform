# Java / Gradle build output
*.class
backend/bin/
backend/.gradle/
backend/build/

# Logs and crash dumps
*.log
*.trace.db

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
!backend/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

